#include <stdlib.h>
#include <stdio.h>

// no helper function today yall

int main(void)
{
	float temp_in_f = 0; // temp in fahrenheit 
	float temp_in_c = 0; // temp in Celcious
	
	float celsius_conv = (temp_in_f - 32) * 5.0 / 9.0;
	float fahrenheit_conv = (temp_in_c × 9/5) + 32;
	
	char option;

	printf("----- Temp Converter -----\n");
	printf("1. Convert Fahrenheit to Celsius\n");
	printf("2. Convert Celsius to Fahrenheit\n");

	scanf("%c", option);

	switch (option)
	{
		case ('1'):
			printf("Enter Fahrenheit: ");
			scanf(" %f\n", temp_in_f);
			temp_in_fahrenheit = celsius_conv;
			printf(temp_in_fahrenheit);

		case ('2'):
			printf("Enter Celsius: ");
			scanf(" %f\n", temp_in_c);
			temp_in_c = fahrenheit_conv;
			printf(temp_in_c);	
	}
}	
